# Datasets - NEVER commit audio files or raw datasets
data/
*.wav
*.mp3
*.ogg
*.flac
*.tar.gz
*.zip
*.tar.bz2

# Model weights & Checkpoints - Do not commit heavy binary weights
*.pt
*.pth
*.onnx
*.bin
*.h5
*.ckpt
checkpoints/
models/*.pt
models/*.pth

